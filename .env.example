# =============================================================================
# Model Evaluation Playbook - Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed.
# 
# This configuration supports separate endpoints for:
#   1. MODEL - The model being tested/evaluated
#   2. JUDGE - The model used to judge/score the responses
#
# This enables scenarios like:
#   - Testing a local Ollama model with GPT-4 as judge
#   - Testing an Azure deployment with OpenRouter judge
#   - Using different API keys for tested vs judge models
# =============================================================================

# -----------------------------------------------------------------------------
# MLFlow Configuration (Optional - for tracking runs)
# -----------------------------------------------------------------------------

# Local MLFlow server:
# MLFLOW_TRACKING_URI=http://localhost:5000/
# MLFLOW_EXPERIMENT_ID=  # Optional - defaults to Default experiment

# Databricks Unity Catalog as tracking server:
# MLFLOW_TRACKING_URI=databricks://<DATABRICKS_AUTH_PROFILE>
# MLFLOW_REGISTRY_URI=databricks-uc
# DATABRICKS_HOST=<DATABRICKS_URL>
# MLFLOW_EXPERIMENT_ID=<EXPERIMENT_ID>

# -----------------------------------------------------------------------------
# Model Configuration (The model being tested)
# -----------------------------------------------------------------------------
# These settings configure the model that will be evaluated.
# Falls back to OPENAI_API_* if not set (for backward compatibility).

MODEL_API_BASE=https://openrouter.ai/api/v1
MODEL_API_KEY=your-model-api-key-here
MODEL_API_VERSION=preview

# -----------------------------------------------------------------------------
# Judge Configuration (The model used for scoring/evaluation)
# -----------------------------------------------------------------------------
# These settings configure the judge model that scores the responses.
# Falls back to MODEL_API_* if not set, then to OPENAI_API_*.

JUDGE_API_BASE=https://openrouter.ai/api/v1
JUDGE_API_KEY=your-judge-api-key-here
JUDGE_API_VERSION=preview

# -----------------------------------------------------------------------------
# Legacy Configuration (Backward Compatibility)
# -----------------------------------------------------------------------------
# If MODEL_API_* and JUDGE_API_* are not set, these values are used as fallback.
# This maintains compatibility with existing .env files.

# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_KEY=your-api-key-here
# OPENAI_API_VERSION=preview

# -----------------------------------------------------------------------------
# Provider-Specific Examples
# -----------------------------------------------------------------------------

# Azure OpenAI/Foundry:
# MODEL_API_BASE=https://<INSTANCE_NAME>.openai.azure.com/openai/v1
# MODEL_API_VERSION=2024-02-15-preview

# OpenRouter:
# MODEL_API_BASE=https://openrouter.ai/api/v1

# Ollama (local):
# MODEL_API_BASE=http://localhost:11434/v1/

# Alibaba Cloud:
# MODEL_API_BASE=https://[ServiceCode].[RegionID].aliyuncs.com/v1
